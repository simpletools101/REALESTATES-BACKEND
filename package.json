{
  "name": "realever-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:seed": "cross-env NODE_ENV=development tsx server/seed.ts",
    "dynamodb:setup": "cross-env NODE_ENV=development tsx server/setup-dynamodb.ts",
    "dynamodb:migrate-from-json": "cross-env NODE_ENV=development tsx server/migrate-to-dynamodb.ts from-json",
    "dynamodb:migrate-from-db": "cross-env NODE_ENV=development tsx server/migrate-to-dynamodb.ts from-db",
    "dynamodb:verify": "cross-env NODE_ENV=development tsx server/migrate-to-dynamodb.ts verify"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.821.0",
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/lib-dynamodb": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@aws-sdk/util-dynamodb": "^3.821.0",
    "@neondatabase/serverless": "^0.10.4",
    "@types/node-fetch": "^2.6.13",
    "adm-zip": "^0.5.16",
    "aws-sdk": "^2.1692.0",
    "basic-ftp": "^5.0.5",
    "cloudinary": "^2.7.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "dropbox": "^10.34.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "firebase": "^12.0.0",
    "memorystore": "^1.6.7",
    "mime-types": "^3.0.1",
    "multer": "^1.4.5-lts.2",
    "nanoid": "^5.1.5",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.9",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "p-limit": "^6.2.0",
    "stripe": "^18.0.0",
    "tmp": "^0.2.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "20.16.11",
    "@types/nodemailer": "^7.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.5.13",
    "cors": "^2.8.5",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
